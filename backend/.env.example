# Optional configuration. Copy to backend/.env; environment variables take precedence.
ADI_ENVIRONMENT=development
# Relative paths are anchored to backend/, independent of the shell's working directory.
ADI_DATA_DIR=data
ADI_SQLITE_TIMEOUT_SECONDS=5
ADI_UPLOADS_ENABLED=true
ADI_UPLOAD_MAX_BYTES=25000000
ADI_UPLOAD_MAX_ROWS=100000
ADI_UPLOAD_MAX_COLUMNS=256
ADI_IMPORT_TIMEOUT_SECONDS=45
# JSON list for a custom local frontend/API port. Unknown browser origins are rejected.
# ADI_UPLOAD_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8000"]
# Upload routes are always disabled when ADI_ENVIRONMENT=production.

# Reserved backend-only secret loading. No model provider or paid calls are enabled yet.
# ADI_MODEL_API_KEY=
# Never place model credentials in frontend variables or commit .env files.
